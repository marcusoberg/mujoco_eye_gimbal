<mujoco>
  <body name="pitch_frame">
    <!-- -Y makes positive pitch raise the +X optical axis. -->
    <joint name="pitch_joint" type="hinge" axis="0 -1 0" range="-40 40"/>
    <inertial pos="0 0 0" mass="0.10" diaginertia="0.0004 0.0003 0.0004"/>
    <!-- Camera U-bracket with one visible pitch motor on the side. -->
    <geom type="capsule" fromto="0 -0.12 0 0.13 -0.12 0" size="0.011"
          rgba="0.18 0.70 0.42 1"/>
    <geom type="capsule" fromto="0 0.12 0 0.13 0.12 0" size="0.011"
          rgba="0.18 0.70 0.42 1"/>
    <geom type="cylinder" pos="0 0.132 0" euler="90 0 0" size="0.048 0.02"
          rgba="0.13 0.52 0.35 1"/>
    <include file="parts/roll.xml"/>
  </body>
</mujoco>
