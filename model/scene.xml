<mujoco model="stabilized_eye_scene">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.001" integrator="implicitfast" gravity="0 0 -9.81"/>
  <visual>
    <global offwidth="1440" offheight="700"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6"/>
  </visual>

  <asset>
    <model name="gimbal" file="gimbal.xml"/>
    <texture name="checker" type="2d" builtin="checker"
             rgb1="0.14 0.19 0.25" rgb2="0.73 0.79 0.83" width="512" height="512"/>
    <material name="checker_mat" texture="checker" texrepeat="12 8"/>
  </asset>

  <worldbody>
    <light pos="1 1 5" dir="-0.3 -0.2 -1"/>
    <geom name="floor" type="plane" size="6 6 0.1" rgba="0.19 0.21 0.23 1"/>

    <!-- Calibration wall is independent of the gimbal assembly. -->
    <geom name="target_wall" type="box" pos="3.5 0 1.2"
          size="0.025 1.8 1.05" material="checker_mat"/>
    <geom type="sphere" pos="3.46 0 1.2" size="0.065" rgba="1 0.1 0.08 1"/>
    <geom type="sphere" pos="3.46 -1.1 1.2" size="0.055" rgba="0.2 0.5 1 1"/>
    <geom type="sphere" pos="3.46 1.1 1.2" size="0.055" rgba="0.2 0.5 1 1"/>
    <geom type="sphere" pos="3.46 0 1.85" size="0.055" rgba="0.1 0.9 0.3 1"/>
    <geom type="sphere" pos="3.46 0 0.55" size="0.055" rgba="0.1 0.9 0.3 1"/>

    <!-- Foreground objects make software focus visually measurable. -->
    <geom type="box" pos="1.7 -0.85 1.20" size="0.025 0.08 0.55"
          rgba="0.95 0.65 0.12 1"/>
    <geom type="box" pos="1.7 0.85 1.20" size="0.025 0.08 0.55"
          rgba="0.95 0.65 0.12 1"/>

    <body name="base_link" mocap="true" pos="0 0 1.2">
      <geom name="base_housing" type="box" size="0.08 0.20 0.065"
            rgba="0.20 0.22 0.25 1" contype="0" conaffinity="0"/>
      <site name="imu_site" size="0.012" rgba="1 0.6 0 1"/>

      <!-- Add another socket + attach with prefix="eye1_" for a second eye. -->
      <body name="eye0_socket" pos="0 0 0">
        <attach model="gimbal" body="mount" prefix="eye0_"/>
      </body>
    </body>
  </worldbody>
  <sensor>
    <gyro name="base_gyro" site="imu_site"/>
    <accelerometer name="base_accel" site="imu_site"/>
  </sensor>
</mujoco>
